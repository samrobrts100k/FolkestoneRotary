# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (https://supabase.com > Project Settings > API) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. NEVER expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Donations: external page visitors are sent to when they press Donate ---
# Leave blank until the donation site is chosen. Optional monthly/regular-giving link too.
NEXT_PUBLIC_DONATE_URL=
NEXT_PUBLIC_DONATE_MONTHLY_URL=

# --- Email (Resend) ---
RESEND_API_KEY=
EMAIL_FROM="Folkestone Rotary <noreply@example.org>"
ADMIN_NOTIFICATION_EMAIL=

# --- Spam protection (optional, Cloudflare Turnstile). Honeypot + timing checks always run. ---
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Analytics (loaded only after cookie consent) ---
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GSC_VERIFICATION=

# --- Maps (optional; falls back to a keyless embed) ---
NEXT_PUBLIC_GOOGLE_MAPS_KEY=
